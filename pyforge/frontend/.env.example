# App URL (for welcome email links) — use your Vercel URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel KV (auto-injected when you connect KV in Vercel dashboard)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# AI Copilot (optional — enables Claude-powered suggestions)
ANTHROPIC_API_KEY=

# Welcome email via SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=PyForge <your-email@gmail.com>

# JWT for auth tokens
JWT_SECRET=pyforge-dev-secret-change-in-production-32chars
